package Assessment;

import org.openqa.selenium.By;
import org.openqa.selenium.WebDriver;

public class OrangeHRMVacancyPage {

    WebDriver driver;

    public OrangeHRMVacancyPage(WebDriver driver) {
        this.driver = driver;
    }

    public void createVacancy(String vacancyName, String jobTitle, String description, String hiringManager, String positions) throws InterruptedException {

        driver.findElement(By.xpath("//span[text()='Recruitment']")).click();
        Thread.sleep(1000);

        driver.findElement(By.xpath("//a[text()='Vacancies']")).click();
        Thread.sleep(1000);

        driver.findElement(By.xpath("//button[normalize-space()='Add']")).click();
        Thread.sleep(1000);

        driver.findElement(By.xpath("//label[text()='Vacancy Name']/../following-sibling::div//input")).sendKeys(vacancyName);
        Thread.sleep(500);

        driver.findElement(By.xpath("//label[text()='Job Title']/../following-sibling::div//div[contains(@class,'oxd-select-text')]")).click();
        Thread.sleep(1000);

        driver.findElement(By.xpath("//div[@role='option']//span[normalize-space()='" + jobTitle + "']")).click();
        Thread.sleep(500);

        driver.findElement(By.xpath("//label[text()='Description']/../following-sibling::div//textarea")).sendKeys(description);
        Thread.sleep(500);

        driver.findElement(By.xpath("//label[text()='Hiring Manager']/../following-sibling::div//input")).sendKeys(hiringManager);
        Thread.sleep(1500);

        driver.findElement(By.xpath("//div[@role='option']//span[normalize-space()='" + hiringManager + "']")).click();
        Thread.sleep(500);

        driver.findElement(By.xpath("//label[text()='Number of Positions']/../following-sibling::div//input")).sendKeys(positions);
        Thread.sleep(500);

        driver.findElement(By.xpath("//button[@type='submit']")).click();
        Thread.sleep(2000);
    }
}
