// Navigate to demoAppsQspiders slidder page
// slide the bar till men cotton jacket and verify.

package FinalAssessment;

import org.openqa.selenium.By;
import org.openqa.selenium.Keys;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.chrome.ChromeDriver;

public class DemoQspidersSlidderPage {

    public static void main(String[] args) throws InterruptedException {

        WebDriver driver = new ChromeDriver();
        driver.manage().window().maximize();
        driver.get("https://demoapps.qspiders.com/ui/slider?sublist=1");
        Thread.sleep(2000);
        WebElement slider = driver.findElement(By.xpath("//input[@type='range']"));
        slider.click();

        for (int i = 0; i < 100; i++) {

            if (driver.getPageSource().contains("Mens Cotton Jacket")) {
                System.out.println("Mens Cotton Jacket found");
                System.out.println("TEST PASS");
                break;
            }

            slider.sendKeys(Keys.ARROW_RIGHT);
            Thread.sleep(2000);
        }
        driver.quit();
    }
}
